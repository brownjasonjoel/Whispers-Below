--- !u!114 &1890767602
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1890767600}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The portal trembles.\n\nIts ancient frame groans beneath the weight of
    something far older than memory.\n\nFor a moment\u2026\n\nSilence.\n\nNo wind.\nNo
    whispers.\n\nOnly the glow of the abyss before you.\n\nBehind lies the world
    you fought to protect\u2014\nthe villages,\nthe fading fires,\nthe people who
    may never know your name.\n\nAhead\u2026\n\nWar.\n\nBeyond the portal waits something
    far worse than the darkness below.\n\nAn endless host.\n\nCreatures twisted beyond
    reason,\ntheir hollow eyes fixed upon the breach between worlds.\n\nAnd in the
    distance\u2026\n\nSomething watches.\n\nSomething ancient.\n\nSomething waiting.\n\nYou
    tighten your grip on your blade.\n\nNo army came.\n\nNo king answered.\n\nSo
    one must stand where none would.\n\nOne step forward.\n\nThen another.\n\nYou
    cross the threshold.\n\nThe portal erupts with light.\n\nThe creatures scream.\n\nSteel
    meets shadow.\n\nAnd as the darkness surges\u2014\n\nThe gate remains open.\n\nFor
    now.\n\nWHISPERS BELOW\n\nThe descent was only the beginning\u2026\n\nTo Be Continued"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
